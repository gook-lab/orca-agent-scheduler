{
  "manifestVersion": 2,
  "id": "agent-cron",
  "name": "OrcaCron 예약",
  "version": "0.2.0",
  "description": "정해진 시각마다 고른 워크스페이스에 Claude Code·Codex·Gemini CLI 를 새로 띄워 글을 보내고, 끝났는지 지켜봅니다. 띄우기는 Orca CLI 로 합니다.",
  "author": {
    "name": "gook-lab",
    "url": "https://github.com/gook-lab"
  },
  "repository": "https://github.com/gook-lab/orca-cron",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "agent-cron",
        "title": "OrcaCron 예약",
        "icon": "calendar",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "next",
        "text": "예약",
        "icon": "calendar",
        "tooltip": "OrcaCron 예약"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "terminal:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}

{
  "manifestVersion": 2,
  "id": "agent-scheduler",
  "name": "Agent Scheduler",
  "version": "0.9.7",
  "description": "Sends a prompt to a Claude Code, Codex or Gemini CLI terminal in Orca at set times — every day, on weekdays, on picked days or dates, or every N minutes. It waits until the terminal is idle, sends through the Orca CLI, and records when the agent finishes. English and Korean.",
  "author": {
    "name": "gook-lab",
    "url": "https://github.com/gook-lab"
  },
  "repository": "https://github.com/gook-lab/orca-agent-scheduler",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "agent-scheduler",
        "title": "Agent Scheduler",
        "icon": "calendar",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "next",
        "text": "Schedules",
        "icon": "calendar",
        "tooltip": "Agent Scheduler"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "terminal:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
